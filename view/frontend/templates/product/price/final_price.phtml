<?php
// @codingStandardsIgnoreFile
/** @var \LeanCommerce\CustomSpecialPriceColor\Block\Pricing\Render\FinalPriceBox $block */

use LeanCommerce\CustomSpecialPriceColor\Model\Presentation\SpecialPricePresentation;

/** @var \Magento\Framework\Pricing\Price\PriceInterface $priceModel */
$priceModel = $block->getPriceType('regular_price');

/** @var \Magento\Framework\Pricing\Price\PriceInterface $finalPriceModel */
$finalPriceModel = $block->getPriceType('final_price');
$idSuffix = $block->getIdSuffix() ? $block->getIdSuffix() : '';
$schema = ($block->getZone() == 'item_view') ? true : false;

$presentation = $block->getSpecialPricePresentation();
$presentationMode = $presentation ? $presentation->getMode() : SpecialPricePresentation::MODE_NONE;
$hasSpecialPrice = $block->hasSpecialPrice();
?>

<?php if ($hasSpecialPrice) :?>
    <?php
    $customLabel = $block->getSpecialPriceLabel();
    if ($presentationMode === SpecialPricePresentation::MODE_SUPER_OFERTA) {
        $displayLabel = $customLabel ?: __('Súper Oferta');
    } elseif ($customLabel) {
        $displayLabel = $customLabel;
    } else {
        $displayLabel = __('Special Price');
    }
    ?>
    <span class="special-price<?= /* @noEscape */ $block->getSpecialPriceModeClass() ?>"<?= /* @noEscape */ $block->getSpecialPriceMarkerAttributes() ?>>
        <?= /* @noEscape */ $block->renderSpecialPriceAmount($finalPriceModel->getAmount(), [
            'display_label'     => $displayLabel,
            'price_id'          => $block->getPriceId('product-price-' . $idSuffix),
            'price_type'        => 'finalPrice',
            'include_container' => true,
            'schema'            => $schema
        ]); ?>
    </span>
    <span class="old-price">
        <?= /* @noEscape */ $block->renderAmount($priceModel->getAmount(), [
            'display_label'     => __('Regular Price'),
            'price_id'          => $block->getPriceId('old-price-' . $idSuffix),
            'price_type'        => 'oldPrice',
            'include_container' => true,
            'skip_adjustments'  => false
        ]); ?>
    </span>
<?php else :?>
    <?= /* @noEscape */ $block->renderAmount($finalPriceModel->getAmount(), [
        'price_id'          => $block->getPriceId('product-price-' . $idSuffix),
        'price_type'        => 'finalPrice',
        'include_container' => true,
        'schema'            => $schema
    ]); ?>
<?php endif; ?>

<?php $thirdPriceAmount = $block->getFormattedThirdPriceAmount(); ?>
<?php if ($thirdPriceAmount !== null) :?>
    <span class="lc-third-price" aria-label="<?= $block->escapeHtmlAttr(__('Normal price')) ?>">
        <span class="lc-third-price__label"><?= $block->escapeHtml($block->getThirdPriceLabel()) ?></span>
        <span class="lc-third-price__amount" style="<?= /* @noEscape */ $block->getThirdPriceAmountStyle() ?>"><?= $block->escapeHtml($thirdPriceAmount) ?></span>
    </span>
<?php endif; ?>

<?php if ($block->showMinimalPrice()) :?>
    <?php if ($block->getUseLinkForAsLowAs()) :?>
        <a href="<?= $block->escapeUrl($block->getSaleableItem()->getProductUrl()) ?>" class="minimal-price-link">
            <?= /* @noEscape */ $block->renderAmountMinimal() ?>
        </a>
    <?php else :?>
        <span class="minimal-price-link">
            <?= /* @noEscape */ $block->renderAmountMinimal() ?>
        </span>
    <?php endif?>
<?php endif; ?>
